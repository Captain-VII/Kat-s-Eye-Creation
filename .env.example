# Copier en .env (jamais commité) et remplir.
PORT=8790
PUBLIC_URL=https://kats-eye-creation.fr
ADMIN_PASSWORD=

# Stripe : https://dashboard.stripe.com/apikeys (clé secrète sk_live_… ou sk_test_… pour essayer)
STRIPE_SECRET_KEY=
# Webhook : endpoint https://<domaine>/api/stripe/webhook, événements checkout.session.completed et checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=

# PayPal : https://developer.paypal.com/dashboard/applications (PAYPAL_ENV=sandbox pour essayer, live en production)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENV=live

# E-mails : smtps://utilisateur:motdepasse@smtp.fournisseur.fr:465
SMTP_URL=
MAIL_FROM="Kat's Eyes Créations <bonjour@kats-eye-creation.fr>"
