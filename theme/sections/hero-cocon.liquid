{{ 'section-hero-cocon.css' | asset_url | stylesheet_tag }}

<div class="hero-cocon color-{{ section.settings.color_scheme }} gradient">
  <div class="hero-cocon__inner page-width section-{{ section.id }}-padding">
    <div class="hero-cocon__text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="kats-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="hero-cocon__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="hero-cocon__body rte">{{ section.settings.text }}</div>
      {%- endif -%}
      <div class="hero-cocon__buttons">
        {%- if section.settings.button_label_1 != blank -%}
          <a
            {% if section.settings.button_link_1 != blank %}
              href="{{ section.settings.button_link_1 }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
            class="button"
          >
            {{- section.settings.button_label_1 | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a
            {% if section.settings.button_link_2 != blank %}
              href="{{ section.settings.button_link_2 }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
            class="button button--secondary"
          >
            {{- section.settings.button_label_2 | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="hero-cocon__visuals">
      <div class="hero-cocon__main stitch-inset">
        {%- if section.settings.image_main != blank -%}
          {{
            section.settings.image_main
            | image_url: width: 1200
            | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 25vw, 50vw', widths: '400, 600, 800, 1000, 1200'
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      <div class="hero-cocon__detail">
        {%- if section.settings.image_detail != blank -%}
          {{
            section.settings.image_detail
            | image_url: width: 800
            | image_tag: loading: 'eager', sizes: '(min-width: 990px) 20vw, 45vw', widths: '300, 500, 800'
          }}
        {%- else -%}
          {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      {%- if section.settings.card_text != blank -%}
        <div class="hero-cocon__card color-{{ section.settings.card_color_scheme }}">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
            <path d="M4 20 20 4"/><circle cx="18" cy="6" r="1.2"/><path d="M4 20c3-1 5-1 7 1" stroke-dasharray="2 2"/>
          </svg>
          <p class="hero-cocon__card-text">{{ section.settings.card_text | escape }}</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Accueil cocon",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petit titre",
      "default": "Couture artisanale · fait main"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Grand titre",
      "info": "Mettez un passage en italique pour le colorer en kaki.",
      "default": "Des créations douces, <em>cousues avec soin</em>, pour un intérieur cocon."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "default": "<p>Plaids, coussins, pochettes et petites douceurs du quotidien, imaginés et cousus un à un dans mon atelier.</p>"
    },
    {
      "type": "header",
      "content": "Boutons"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Bouton principal",
      "default": "Découvrir la boutique"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Lien du bouton principal"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Second bouton",
      "default": "L'histoire de l'atelier"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Lien du second bouton"
    },
    {
      "type": "header",
      "content": "Photos"
    },
    {
      "type": "image_picker",
      "id": "image_main",
      "label": "Grande photo (forme d'arche)"
    },
    {
      "type": "image_picker",
      "id": "image_detail",
      "label": "Photo de détail"
    },
    {
      "type": "text",
      "id": "card_text",
      "label": "Texte de la carte bois",
      "default": "Pièces uniques & petites séries"
    },
    {
      "type": "header",
      "content": "Couleurs et espacement"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Couleurs de la carte",
      "default": "scheme-4"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Accueil cocon"
    }
  ]
}
{% endschema %}
